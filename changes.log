  files: game/maker.py (new), game/castle.py, game/app.py, game/arena.py, game/levels.py, game/selftest.py, castles/examples/starter_keep.json (new), .gitignore, tests/test_maker.py, tests/test_castle.py, tests/test_scroll.py, qa/render_shots.py, README.md
